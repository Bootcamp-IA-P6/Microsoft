# API EMT Madrid (MobilityLabs) — obtenido en mobilitylabs.emtmadrid.es

# App credentials (preferred — 250k requests/day)
EMT_CLIENT_ID=
EMT_MADRID_PASS_KEY=

# Optional fallback if app credentials unavailable (20k/day)
EMT_EMAIL=
EMT_PASSWORD=

# Azure OpenAI / Fabric — se completa cuando lleguemos a Fase 3
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# Azure Speech — para reconocimiento de voz del micrófono
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_SPEECH_LANGUAGE=es-ES
