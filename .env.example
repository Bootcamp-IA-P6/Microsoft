# API EMT Madrid (MobilityLabs) — obtenido en mobilitylabs.emtmadrid.es

# App credentials (preferred — 250k requests/day)
EMT_CLIENT_ID=
EMT_MADRID_PASS_KEY=

# Fabric Eventstream Custom Endpoint SAS (Variable Library EVENTSTREAM_CONNECTION_STRING).
# Do not commit real values. Local .env is optional; Fabric VL is the runtime source.
# EVENTSTREAM_CONNECTION_STRING=

# Optional fallback if app credentials unavailable (20k/day)
EMT_EMAIL=
EMT_PASSWORD=

# Azure OpenAI / Fabric — se completa cuando lleguemos a Fase 3
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

#Opcional
ANTHROPIC_API_KEY=
GROQ_API_KEY=