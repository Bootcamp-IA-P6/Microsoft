// =============================================================================
// 02 — silver_arrives
// Preferred: UDF emits emt_record=silver_arrives → Eventstream → this table
// (Python expand = Lakehouse arrives_transform parity)
// bus_lat/bus_lon: Arrive[].geometry GeoJSON Point coordinates [lon, lat]
// =============================================================================

.create-merge table silver_arrives (
    emt_record: string,
    _rk: string,
    stop_id: string,
    line_id: string,
    line_label: string,
    direction_id: int,
    bus_id: string,
    destination: string,
    eta_seconds: int,
    bus_lat: real,
    bus_lon: real,
    datetime_polling: datetime,
    ingested_at: datetime,
    stop_name: string,
    stop_lat: real,
    stop_lon: real,
    direction_text: string,
    name_a: string,
    name_b: string,
    is_terminus: bool,
    catalog_loaded_at: datetime,
    day_type: string,
    map_ok: bool
)

.create-or-alter table silver_arrives ingestion json mapping 'silver_arrives_json'
'['
'  {"column":"emt_record","path":"$.emt_record"},'
'  {"column":"_rk","path":"$._rk"},'
'  {"column":"stop_id","path":"$.stop_id"},'
'  {"column":"line_id","path":"$.line_id"},'
'  {"column":"line_label","path":"$.line_label"},'
'  {"column":"direction_id","path":"$.direction_id"},'
'  {"column":"bus_id","path":"$.bus_id"},'
'  {"column":"destination","path":"$.destination"},'
'  {"column":"eta_seconds","path":"$.eta_seconds"},'
'  {"column":"bus_lat","path":"$.bus_lat"},'
'  {"column":"bus_lon","path":"$.bus_lon"},'
'  {"column":"datetime_polling","path":"$.datetime_polling"},'
'  {"column":"ingested_at","path":"$.ingested_at"},'
'  {"column":"stop_name","path":"$.stop_name"},'
'  {"column":"stop_lat","path":"$.stop_lat"},'
'  {"column":"stop_lon","path":"$.stop_lon"},'
'  {"column":"direction_text","path":"$.direction_text"},'
'  {"column":"name_a","path":"$.name_a"},'
'  {"column":"name_b","path":"$.name_b"},'
'  {"column":"is_terminus","path":"$.is_terminus"},'
'  {"column":"catalog_loaded_at","path":"$.catalog_loaded_at"},'
'  {"column":"day_type","path":"$.day_type"},'
'  {"column":"map_ok","path":"$.map_ok"}'
']'

// Optional dedupe retention helper (run periodically):
// .set-or-replace silver_arrives_dedup <|
//   silver_arrives | summarize arg_max(ingested_at, *) by _rk
