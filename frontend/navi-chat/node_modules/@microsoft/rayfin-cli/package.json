{
  "name": "@microsoft/rayfin-cli",
  "version": "1.33.2",
  "description": "Command-line interface for Rayfin platform",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./_internal/commands/init.js": "./dist/commands/init.js",
    "./_internal/errors.js": "./dist/errors.js",
    "./_internal/telemetry": {
      "import": "./dist/telemetry/_internal.js",
      "types": "./dist/telemetry/_internal.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rayfin": "scripts/main"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "!dist/**/__tests__/**",
    "assets",
    "scripts/main",
    "templates",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0 <21.0.0 || >=22.0.0 <23.0.0 || >=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@azure/msal-node-extensions": "^1.3.0",
    "@types/cli-progress": "^3.11.6",
    "@types/jsonwebtoken": "^9.0.10",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "figlet": "^1.7.0",
    "glob": "^10.5.0",
    "inquirer": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "ora": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3",
    "uuid": "^11.1.1",
    "yaml": "^2.8.3",
    "archiver": "^7.0.1",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/sdk-node": "~0.217.0",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.41",
    "tedious": "~19.2.1",
    "@microsoft/rayfin-tools-common": "1.33.2",
    "@microsoft/rayfin-core": "1.33.2",
    "@microsoft/rayfin-docs": "1.33.2",
    "@microsoft/rayfin-guide": "1.33.2"
  },
  "optionalDependencies": {
    "@vscode/deviceid": "~0.1.4"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^24.0.10",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "rimraf": "~6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4",
    "@types/archiver": "^7.0.0",
    "minimatch": "~10.2.3"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/rayfin.git",
    "directory": "packages/tools/cli"
  },
  "scripts": {
    "start": "node scripts/main",
    "build": "tsx scripts/bundle-templates.ts && node scripts/generate-build-info && tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist && rimraf .tsbuildinfo && rimraf templates",
    "test": "vitest --run",
    "test:watch": "vitest",
    "eval:docs-transports": "tsx eval/docs-transports/eval.ts",
    "eval:llm-agent": "tsx eval/llm-agent-comparison/eval.ts"
  }
}