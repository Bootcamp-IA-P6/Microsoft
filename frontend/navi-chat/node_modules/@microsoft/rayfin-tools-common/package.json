{
  "name": "@microsoft/rayfin-tools-common",
  "version": "1.33.2",
  "description": "Shared utilities for Rayfin tools packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./_internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts"
    },
    "./_internal/auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./_internal/checks": {
      "import": "./dist/checks/index.js",
      "types": "./dist/checks/index.d.ts"
    },
    "./_internal/config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./_internal/templates": {
      "import": "./dist/templates/index.js",
      "types": "./dist/templates/index.d.ts"
    },
    "./_internal/templates/git": {
      "import": "./dist/templates/git/index.js",
      "types": "./dist/templates/git/index.d.ts"
    },
    "./_internal/templates/universal": {
      "import": "./dist/templates/universal.js",
      "types": "./dist/templates/universal.d.ts"
    },
    "./_internal/telemetry": {
      "import": "./dist/telemetry/index.js",
      "types": "./dist/telemetry/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/rayfin.git",
    "directory": "packages/tools/common"
  },
  "dependencies": {
    "tar": "~7.5.15",
    "yaml": "^2.8.2",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "rimraf": "~6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "vitest --run"
  }
}